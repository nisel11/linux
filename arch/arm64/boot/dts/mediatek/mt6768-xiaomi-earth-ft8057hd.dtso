/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mediatek,mt6768-pinfunc.h>

&{/} {
	reg_lcd_bias_enn: regulator-lcd-bias-enn {
		compatible = "regulator-fixed";
		regulator-name = "lcd_bias_enn";
		regulator-min-microvolt = <6000000>;
		regulator-max-microvolt = <6000000>;
		gpio = <&pio 165 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&panel_enn_pins>;
		pinctrl-names = "default";
		enable-active-high;
		startup-delay-us = <5000>;
	};

	reg_lcd_bias_enp: regulator-lcd-bias-enp {
		compatible = "regulator-fixed";
		regulator-name = "lcd_bias_enp";
		regulator-min-microvolt = <6000000>;
		regulator-max-microvolt = <6000000>;
		gpio = <&pio 169 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&panel_enp_pins>;
		pinctrl-names = "default";
		enable-active-high;
		startup-delay-us = <3000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 50000>;
	};
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel: panel@0 {
		compatible = "focaltech,ft8057hd";
		reg = <0>;
		pinctrl-0 = <&panel_pins>;
		pinctrl-names = "default";

		vddio-supply = <&mt6358_vio18_reg>;
		vddpos-supply = <&reg_lcd_bias_enp>;
		vddneg-supply = <&reg_lcd_bias_enn>;
		reset-gpios = <&pio 45 GPIO_ACTIVE_HIGH>;

		backlight = <&backlight>;

		port {
			ft8057_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&ft8057_in>;
};

&mipi_tx0 {
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	mediatek,pad-select = <0>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	touchscreen@0 {
		compatible = "focaltech,ft8057";
		reg = <0>;
		pinctrl-0 = <&touch_pins>;
		pinctrl-names = "default";
		spi-max-frequency = <6000000>;
		spi-cs-setup-delay-ns = <230>;

		interrupts-extended = <&pio 1 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 92 GPIO_ACTIVE_HIGH>;

		firmware-name = "focaltech_ts_fw_djn.bin";

		touchscreen-size-x = <720>;
		touchscreen-size-y = <1650>;
		panel = <&panel>;
	};
};

&pio {
	touch_pins: touch-pins {
		pins-int {
			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
			input-enable;
			bias-disable;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO92__FUNC_GPIO92>;
			bias-disable;
		};
	};

	panel_pins: panel-pins {
		pins-rst {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			bias-disable;
		};
	};

	panel_enp_pins: panel-enp-pins {
		pins-en {
			pinmux = <PINMUX_GPIO169__FUNC_GPIO169>;
			bias-disable;
		};
	};

	panel_enn_pins: panel-enn-pins {
		pins-en {
			pinmux = <PINMUX_GPIO165__FUNC_GPIO165>;
			bias-disable;
		};
	};

	lcd_disp_pwm: lcd-disp-pwm {
		pins-pwm {
			pinmux = <PINMUX_GPIO43__FUNC_DISP_PWM>;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_disp_pwm>;
};
